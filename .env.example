# Default country code added to numbers that start with 0 (e.g. 03001234567 -> 923001234567)
DEFAULT_COUNTRY_CODE=92

# Used when a row in contacts.csv has an empty message. Supports {name} placeholder.
DEFAULT_MESSAGE=Hi {name}, this is a test message from my script.

# Random delay between messages, in seconds
MIN_DELAY=5
MAX_DELAY=15

# Input / output files
CONTACTS_FILE=contacts.csv
RESULTS_FILE=results.csv

# Extra pages allowed to use the local server (your Netlify URL), comma separated
ALLOWED_ORIGINS=https://wabulksenderhussnain.netlify.app
