{
  "name": "whatsapp-bulk-sender",
  "version": "1.1.0",
  "description": "Send WhatsApp messages to many numbers from your own PC, with a terminal and a web interface.",
  "author": "Dev-Husnain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-Husnain/WhatsAppBulkSender.git"
  },
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dry-run": "node src/index.js --dry-run",
    "resume": "node src/index.js --resume",
    "server": "node src/server.js",
    "logout": "node src/logout.js",
    "deploy": "npx netlify-cli deploy --prod --dir public",
    "build:exe": "node scripts/build-exe.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "allowScripts": {
    "puppeteer@24.38.0": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "puppeteer-core": "^24.38.0"
  }
}
